#!/bin/bash
# Pre-commit hook to automatically sign the Karcytics plugin.
# Interim: full pre-commit framework migration (ruff/mypy/pytest/sign) lands
# separately; this just keeps `karcytics-sdk sign` current on every commit.

echo "Signing plugin with Karcytics SDK..."
PLUGIN_ID=$(grep '^id =' pyproject.toml | head -1 | cut -d'"' -f2)

if [ -z "$PLUGIN_ID" ]; then
    echo "Error: Could not find plugin ID in pyproject.toml"
    exit 1
fi

if [ "$(basename "$PWD")" != "$PLUGIN_ID" ]; then
    ln -s . "$PLUGIN_ID"
    karcytics-sdk sign "$PLUGIN_ID"
    rm "$PLUGIN_ID"
else
    karcytics-sdk sign "$PWD"
fi

if [ $? -ne 0 ]; then
    echo "Error: Failed to sign plugin."
    exit 1
fi

# Add the generated security files to the commit
git add security.json signature.bin trust_chain.json 2>/dev/null || true
echo "Plugin signed successfully."
